{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // Deliberately scoped to "src" only — vite.config.ts (which imports from "node:url") is
  // intentionally outside this type-checked scope. It's a one-line config file unlikely to
  // regress silently; including root config files would require adding @types/node for no
  // real safety benefit today.
  "include": ["src"]
}
